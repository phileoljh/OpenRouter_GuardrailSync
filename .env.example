# ==============================================================================
# OpenRouter Guardrail 同步與費率過濾環境變數設定範本 (.env.example)
# 使用方式：請複製本檔為 .env 並填入實際的認證金鑰與參數
# 注意事項：請勿將包含真實金鑰的 .env 提交至 Git 版本控制
# ==============================================================================

# 1. OpenRouter 管理專用 API Key (Management / Provisioning Key)
# 說明：此金鑰必須具備讀取模型與更新 Guardrails 的權限（非一般呼叫用的推論金鑰）
# 取得途徑：https://openrouter.ai/settings/keys
OPENROUTER_MANAGEMENT_KEY=your_openrouter_management_key_here

# 2. 目標 Guardrail ID
# 說明：要同步更新白名單模型的 Guardrail 識別碼
# 取得途徑：可在 OpenRouter 後台 Guardrails 設定頁面之 URL 或詳細資訊中取得
OPENROUTER_GUARDRAIL_ID=your_guardrail_id_here

# 3. 費率門檻限制 (單位：美元 / 每百萬 Token，即 $/M tokens)
# 說明：腳本會自動納入所有完全免費的模型 (單價為 0)，並篩選不超過以下門檻的平價模型
MAX_INPUT_PRICE_PER_M=0.25
MAX_OUTPUT_PRICE_PER_M=0.50
